+uint64
+kcollect_free()
+{
+  struct run* r;
+  int cnt = 0;
+
+  acquire(&kmem.lock);
+
+  r = kmem.freelist;
+  while(r) {
+    ++cnt;
+    r = r->next;
+  }
+
+  release(&kmem.lock);
+  return cnt * PGSIZE;
+}
