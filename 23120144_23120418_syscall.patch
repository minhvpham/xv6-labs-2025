+uint64
+sys_sysinfo(void)
+{
+  uint64 addr;
+  struct sysinfo sinfo;
+  struct proc* p = myproc();
+
+  argaddr(0, &addr);
+
+  sinfo.freemem = kcollect_free();
+  sinfo.nproc = count_active_proc();
+  sinfo.loadavg = global_loadavg;
+
+  if (copyout(p->pagetable, addr, (char*)&sinfo, sizeof(sinfo)) < 0)
+    return -1;
+
+  return 0;
+}
